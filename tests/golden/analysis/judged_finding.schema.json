{
  "$defs": {
    "Confidence": {
      "enum": [
        "high",
        "med",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Dimension": {
      "enum": [
        "architecture",
        "maintainability",
        "security",
        "tests_deps"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "Refutation": {
      "enum": [
        "survived",
        "refuted",
        "not_required",
        "pending"
      ],
      "title": "Refutation",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One judged.jsonl line, written by a judge agent; finalize assigns the id.\n\nA judge never decides refutation (critical/high are pending for the refuter, the rest\nnot_required) and uses only its dimension's rule prefix \u2014 `validate` and finalize both\nenforce it here. The messages are constants: they never quote the input.",
  "properties": {
    "anchor": {
      "title": "Anchor",
      "type": "string"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "dimension": {
      "$ref": "#/$defs/Dimension"
    },
    "evidence": {
      "maxLength": 2000,
      "title": "Evidence",
      "type": "string"
    },
    "line": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Line"
    },
    "origin": {
      "const": "judged",
      "title": "Origin",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "refutation": {
      "$ref": "#/$defs/Refutation"
    },
    "rule": {
      "pattern": "^[a-z][a-z_]*\\.[a-z0-9][a-z0-9_.-]{0,63}$",
      "title": "Rule",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "dimension",
    "severity",
    "confidence",
    "rule",
    "title",
    "path",
    "line",
    "anchor",
    "refutation",
    "evidence",
    "origin"
  ],
  "title": "JudgedFinding",
  "type": "object"
}

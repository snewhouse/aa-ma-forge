#!/usr/bin/env bash
# gh — PATH-shadowed stub for sole-dev-merge bats tests.
#
# Logs every invocation as one line to "$CLI_LOG" (env var; required).
#
# Behaviour env vars (defaults shown):
#   GH_PR_EXISTS=0       — `gh pr view ...` exit 1 (no PR); =1 → exit 0 + JSON.
#   GH_AUTH_OK=1         — `gh auth status` exit 0; =0 → exit 1 (auth failure).
#   GH_WATCH_HANG=0      — `gh pr checks --watch` exits 0; =1 → hangs (sleeps
#                           999s) so an outer `timeout Ns` triggers RC=124.
#   GH_CHECKS_RC=0       — exit code for `gh pr checks` (when not hanging).
#                           Use 0 for green, 1+ for failure. Ignored when HANG=1.
#   GH_ALLOW_REBASE=true — `gh api repos/.../allow_rebase_merge` echoes this.
#                           Set to "false" to simulate rebase-merge disabled.

set -eu

LOG="${CLI_LOG:-/dev/null}"
echo "gh $*" >> "$LOG"

case "${1:-}" in
    pr)
        case "${2:-}" in
            view)
                # §6.8 M4 CRITICAL-1 fix: Stage F now queries `--jq '.url'` and
                # `--jq '.number'` to extract PR_URL + PR_NUM. Honour both
                # filters even when PR_EXISTS=0 (post-create-the-PR-exists).
                if [[ "$*" == *"--jq .url"* || "$*" == *"--jq '.url'"* ]]; then
                    echo "https://github.com/test/repo/pull/42"
                    exit 0
                elif [[ "$*" == *"--jq .number"* || "$*" == *"--jq '.number'"* ]]; then
                    echo "42"
                    exit 0
                fi
                if [[ "${GH_PR_EXISTS:-0}" == "1" ]]; then
                    echo '{"url":"https://github.com/test/repo/pull/42"}'
                    exit 0
                else
                    exit 1
                fi
                ;;
            checks)
                # CI poll path — supports never-return mode for timeout tests.
                if [[ "${GH_WATCH_HANG:-0}" == "1" ]]; then
                    # Block until outer `timeout` kills us (RC=124).
                    sleep 999
                fi
                exit "${GH_CHECKS_RC:-0}"
                ;;
            create|edit)
                # §6.8 M4 CRITICAL-1 fix: real gh prints the new/updated PR URL
                # to stdout (last line); Stage F captures it. Mirror that.
                echo "https://github.com/test/repo/pull/42"
                exit 0
                ;;
            merge)
                exit 0
                ;;
        esac
        ;;
    auth)
        case "${2:-}" in
            status)
                # Honour GH_AUTH_OK=0 to simulate auth failure.
                if [[ "${GH_AUTH_OK:-1}" == "0" ]]; then
                    echo "You are not logged in" >&2
                    exit 1
                fi
                echo "Logged in to github.com account test"
                exit 0
                ;;
        esac
        ;;
    api)
        # M4 branch-protection check expects 'true'|'false' from --jq filter.
        # M3 idempotency tests don't depend on this output (they only check
        # PR-view behaviour), so changing default is safe.
        echo "${GH_ALLOW_REBASE:-true}"
        exit 0
        ;;
esac

exit 0

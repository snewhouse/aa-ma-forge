# codemem layer-boundary enforcement (M1 Task 1.11).
#
# Run locally: uv run lint-imports
# Run in CI: GitHub Actions `security.yml` (codemem-smoke job) runs
# `uv run lint-imports` after `uv sync` (diagram-generation M2).
#
# Contracts:
#
# 1. Layered architecture inside the codemem package: storage is the
#    leaf, parser sits above it, and the orchestrators + public API
#    sit on top. storage must not know anything about parser; parser
#    must not know anything about mcp_tools.
#
# 2. codemem.parser must not import from codemem.mcp_tools (back-edge
#    forbidden — the parser layer is pure and must stay reusable).
#
# 3. aa_ma.render is a leaf: derived views (lint, HTML) may import the
#    grammar and parsers, but nothing in aa_ma may import aa_ma.render
#    (plan-architecture-views M2, ADR-0010).
#
# 4. aa_ma never imports codemem: aa_ma.render.graph reads codemem's SQLite
#    file with stdlib sqlite3, so the coupling is the on-disk schema, not a
#    Python API (diagram-generation M2, ADR-0014). `source_modules = aa_ma`
#    is accepted here — the shared-descendants refusal noted in contract 3
#    applies only when source and forbidden share a root package.
#
# 5. aa_ma.analysis is a leaf both ways (codebase-analysis-skills M1): nothing in aa_ma imports it,
#    and it imports no other aa_ma module (stdlib + pydantic only). Both lists are explicit and
#    pinned by tests/render/test_leaf_contract.py.
#
# 6. aa_ma.gitutil imports no other aa_ma module (code-conventions-impact 10.4): it is the
#    stdlib-only twin of codemem.gitutil, so either can be read without the rest of its package.
#    Pinned by tests/render/test_leaf_contract.py.
#
# 7. aa_ma.contract_rows imports aa_ma.grammar and no other aa_ma module (code-conventions-impact
#    11.2). Direct imports only: grammar imports plan_parsers, which is exactly why the row grammar
#    could not live in plan_parsers. Pinned by tests/render/test_leaf_contract.py.

[importlinter]
root_packages =
    codemem
    aa_ma

[importlinter:contract:codemem-layers]
name = codemem layered architecture
type = layers
layers =
    codemem.mcp_tools : codemem.indexer : codemem.resolver : codemem.pagerank
    codemem.parser
    codemem.storage

[importlinter:contract:parser-is-pure]
name = parser must not depend on public API
type = forbidden
source_modules =
    codemem.parser
    codemem.parser.python_ast
    codemem.parser.ast_grep
forbidden_modules =
    codemem.mcp_tools
    codemem.indexer
    codemem.resolver
    codemem.pagerank

[importlinter:contract:render-is-leaf]
name = aa_ma.render is a leaf package
type = forbidden
# Every top-level aa_ma module except render. import-linter's `forbidden` type
# refuses `source_modules = aa_ma` ("shared descendants"), so the list is explicit
# and tests/render/test_leaf_contract.py fails when a module is added but not listed.
source_modules =
    aa_ma.analysis
    aa_ma.cli
    aa_ma.contract_rows
    aa_ma.deps
    aa_ma.enforce
    aa_ma.forks
    aa_ma.gate
    aa_ma.gitutil
    aa_ma.goal_synthesis
    aa_ma.grammar
    aa_ma.logsetup
    aa_ma.plan_markers
    aa_ma.plan_parsers
    aa_ma.schemas
    aa_ma.tui
    aa_ma.validators
forbidden_modules =
    aa_ma.render

[importlinter:contract:aa-ma-never-imports-codemem]
name = aa_ma never imports codemem
type = forbidden
source_modules =
    aa_ma
forbidden_modules =
    codemem

[importlinter:contract:analysis-is-leaf]
name = analysis-is-leaf: aa_ma.analysis is a leaf package
type = forbidden
source_modules =
    aa_ma.cli
    aa_ma.contract_rows
    aa_ma.deps
    aa_ma.enforce
    aa_ma.forks
    aa_ma.gate
    aa_ma.gitutil
    aa_ma.goal_synthesis
    aa_ma.grammar
    aa_ma.logsetup
    aa_ma.plan_markers
    aa_ma.plan_parsers
    aa_ma.render
    aa_ma.schemas
    aa_ma.tui
    aa_ma.validators
forbidden_modules =
    aa_ma.analysis

[importlinter:contract:analysis-is-self-contained]
name = analysis-is-self-contained: aa_ma.analysis imports no other aa_ma module
type = forbidden
source_modules =
    aa_ma.analysis
forbidden_modules =
    aa_ma.cli
    aa_ma.contract_rows
    aa_ma.deps
    aa_ma.enforce
    aa_ma.forks
    aa_ma.gate
    aa_ma.gitutil
    aa_ma.goal_synthesis
    aa_ma.grammar
    aa_ma.logsetup
    aa_ma.plan_markers
    aa_ma.plan_parsers
    aa_ma.render
    aa_ma.schemas
    aa_ma.tui
    aa_ma.validators

[importlinter:contract:gitutil-is-self-contained]
name = gitutil-is-self-contained: aa_ma.gitutil imports no other aa_ma module
type = forbidden
source_modules =
    aa_ma.gitutil
forbidden_modules =
    aa_ma.analysis
    aa_ma.cli
    aa_ma.contract_rows
    aa_ma.deps
    aa_ma.enforce
    aa_ma.forks
    aa_ma.gate
    aa_ma.goal_synthesis
    aa_ma.grammar
    aa_ma.logsetup
    aa_ma.plan_markers
    aa_ma.plan_parsers
    aa_ma.render
    aa_ma.schemas
    aa_ma.tui
    aa_ma.validators

[importlinter:contract:contract-rows-reads-grammar-only]
name = contract-rows-reads-grammar-only: aa_ma.contract_rows imports only aa_ma.grammar from aa_ma
type = forbidden
allow_indirect_imports = True
source_modules =
    aa_ma.contract_rows
forbidden_modules =
    aa_ma.analysis
    aa_ma.cli
    aa_ma.deps
    aa_ma.enforce
    aa_ma.forks
    aa_ma.gate
    aa_ma.gitutil
    aa_ma.goal_synthesis
    aa_ma.logsetup
    aa_ma.plan_markers
    aa_ma.plan_parsers
    aa_ma.render
    aa_ma.schemas
    aa_ma.tui
    aa_ma.validators
